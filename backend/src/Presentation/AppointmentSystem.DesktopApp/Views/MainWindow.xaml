<Window x:Class="AppointmentSystem.DesktopApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý lịch hẹn - Desktop Client (TCP Socket)" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2C3E50"
                    VerticalAlignment="Stretch">
            <TextBlock Text="🗓 APPOINTMENT SYSTEM" Foreground="White"
                       FontSize="15" FontWeight="Bold" Margin="15,0,25,0"
                       VerticalAlignment="Center"/>
            <Button Content="📋 Tất cả lịch" Click="BtnAll_Click" Margin="4" Padding="10,5"/>
            <Button Content="⏳ Chờ duyệt" Click="BtnPending_Click" Margin="4" Padding="10,5"/>
            <Button Content="✅ Đã xác nhận" Click="BtnConfirmed_Click" Margin="4" Padding="10,5"/>
            <Button Content="📊 Thống kê" Click="BtnStats_Click" Margin="4" Padding="10,5"/>
            <Button Content="🔧 Quản lý Dịch vụ" Click="BtnServices_Click" Margin="4" Padding="10,5"/>
            <Button Content="🔄 Làm mới" Click="BtnRefresh_Click" Margin="4" Padding="10,5"
                    Background="#27AE60" Foreground="White"/>
            <Button Content="⛔ Đăng xuất" Click="BtnLogout_Click" Margin="4" Padding="10,5"
                    Background="#E74C3C" Foreground="White" HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- Main content -->
        <TabControl Grid.Row="1" x:Name="TabMain">

            <!-- Tab Lịch hẹn -->
            <TabItem Header="Danh sách Lịch hẹn">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="DgAppointments" Grid.Row="0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" Margin="5"
                              AlternatingRowBackground="#F8F9FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="150"/>
                            <DataGridTextColumn Header="Dịch vụ" Binding="{Binding ServiceName}" Width="150"/>
                            <DataGridTextColumn Header="Ngày hẹn" Binding="{Binding AppointmentDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Giờ" Binding="{Binding StartTime}" Width="70"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding StaffName}" Width="130"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusVietnamese}" Width="110"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                        <Button Content="✅ Xác nhận lịch" Click="BtnConfirm_Click"
                                Padding="15,8" Margin="5" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
                        <Button Content="❌ Hủy lịch" Click="BtnCancel_Click"
                                Padding="15,8" Margin="5" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
                        <Button Content="🏁 Hoàn thành" Click="BtnComplete_Click"
                                Padding="15,8" Margin="5" Background="#3498DB" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab Dịch vụ -->
            <TabItem Header="Dịch vụ" x:Name="TabServices">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="DgServices" Grid.Column="0"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Thời lượng (phút)" Binding="{Binding DurationMinutes}" Width="110"/>
                            <DataGridTextColumn Header="Giá (VNĐ)" Binding="{Binding Price, StringFormat=N0}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Form thêm/sửa dịch vụ -->
                    <Border Grid.Column="1" Background="#F8F9FA" Padding="15" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Thêm / Cập nhật Dịch vụ" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                            <Label Content="Tên dịch vụ:"/>
                            <TextBox x:Name="TxtServiceName" Margin="0,0,0,8" Padding="5"/>
                            <Label Content="Mô tả chi tiết:"/>
                            <TextBox x:Name="TxtDescription" Margin="0,0,0,8" Padding="5" Height="60"
                                     TextWrapping="Wrap" AcceptsReturn="True"/>
                            <Label Content="Thời lượng (phút):"/>
                            <TextBox x:Name="TxtDuration" Margin="0,0,0,8" Padding="5" Text="30"/>
                            <Label Content="Giá (VNĐ):"/>
                            <TextBox x:Name="TxtPrice" Margin="0,0,0,12" Padding="5" Text="200000"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="💾 Lưu dịch vụ" Click="BtnSaveService_Click"
                                        Padding="15,8" Background="#27AE60" Foreground="White" Margin="0,0,6,0" FontWeight="Bold"/>
                                <Button Content="🗑 Ẩn dịch vụ" Click="BtnDeactivateService_Click"
                                        Padding="15,8" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Background="#ECF0F1">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Sẵn sàng kết nối TCP Port 5050"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
