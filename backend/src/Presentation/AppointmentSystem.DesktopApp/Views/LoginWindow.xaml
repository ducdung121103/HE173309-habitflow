<Window x:Class="AppointmentSystem.DesktopApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - Quản lý lịch hẹn" Height="340" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#2C3E50">
        <Border Background="White" CornerRadius="12" Margin="25" Padding="25">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🗓 APPOINTMENT SYSTEM" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="#2C3E50"/>
                <TextBlock Text="Đăng nhập Quản trị viên / Nhân viên" FontSize="12" Foreground="Gray"
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Label Content="Email đăng nhập:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtEmail" Padding="8,6" Margin="0,0,0,10"
                         Text="admin@appointment.com"/>

                <Label Content="Mật khẩu:" FontWeight="SemiBold"/>
                <PasswordBox x:Name="TxtPassword" Password="123456" Padding="8,6" Margin="0,0,0,15"/>

                <Button Content="Đăng nhập (TCP Socket)" Click="BtnLogin_Click"
                        Height="38" Background="#2C3E50" Foreground="White"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"/>

                <TextBlock x:Name="TxtError" Foreground="Red" Margin="0,8,0,0"
                           TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
